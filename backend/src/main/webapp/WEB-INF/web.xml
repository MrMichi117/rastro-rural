<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Rastro Rural</display-name>
  <listener><listener-class>co.edu.travesias.rastro.Database</listener-class></listener>
  <filter><filter-name>security</filter-name><filter-class>co.edu.travesias.rastro.SecurityFilter</filter-class></filter>
  <filter-mapping><filter-name>security</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <servlet><servlet-name>api</servlet-name><servlet-class>co.edu.travesias.rastro.ApiServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>api</servlet-name><url-pattern>/api/*</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
